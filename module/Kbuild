# Out-of-tree build of the USB gadget ECM and CDC-subset functions for the
# running 4.9.337-Phenix kernel, which has u_ether built in but not these.
# NCM is left out: its Huawei hook (function-hisi/f_ncm_hisi.c) is missing
# from the source drop, and the TP-Link only needs ECM.
obj-m := usb_f_ecm.o usb_f_ecm_subset.o
usb_f_ecm-y := f_ecm.o
usb_f_ecm_subset-y := f_subset.o

ccflags-y += -I$(srctree)/drivers/usb/gadget -I$(srctree)/drivers/usb/gadget/function
